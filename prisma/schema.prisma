generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Server {
  id           String   @id
  name         String
  erlcApiKey   String?
  pcrChannelId String?
  logChannelId String?
  members      Member[]
  pcrs         Pcr[]
  warrants     Warrant[]
}

model Member {
  id             String   @id @default(cuid())
  discordId      String
  robloxId       String?
  robloxUsername String?
  rank           String   @default("Recruit")
  serverId       String
  server         Server   @relation(fields: [serverId], references: [id])
  pcrs           Pcr[]
  warrantsFiled  Warrant[]

  @@unique([discordId, serverId])
}

model Pcr {
  id           String    @id @default(cuid())
  pcrNumber    Int
  serverId     String
  memberId     String
  unitNumber   String
  callType     String
  disposition  String
  commandTeam  String?
  narrative    String
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  server       Server    @relation(fields: [serverId], references: [id])
  member       Member    @relation(fields: [memberId], references: [id])

  @@unique([serverId, pcrNumber])
}

model Warrant {
  id             String    @id @default(cuid())
  warrantNumber  Int
  serverId       String
  targetRobloxId String
  targetName     String
  type           String
  reason         String
  status         String   @default("ACTIVE")
  filedById      String
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  server         Server   @relation(fields: [serverId], references: [id])
  filedBy        Member   @relation(fields: [filedById], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  serverId  String
  actorId   String
  action    String
  details   String
  createdAt DateTime @default(now())
}